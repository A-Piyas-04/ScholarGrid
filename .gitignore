# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Data: raw corpus is reproducible from the pipeline; do not commit large files.
data/raw/*
!data/raw/.gitkeep

# Processed artifacts can be regenerated; keep the folder but ignore big binaries.
data/processed/*
!data/processed/.gitkeep

# Pipeline stage outputs, embedding cache, published releases and the DuckDB store.
data/stages/
data/releases/
data/live/
data/grow_status.json
data/grow.log
data/llm_cache/
data/llm_usage/
data/fulltext/
data/extract/
data/workspaces/
data/app.db
data/app.db-shm
data/app.db-wal
data/app.db-journal
*.duckdb
*.duckdb.wal

# Local secrets and tool caches
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml

# Reports are generated by the pipeline.
reports/*
!reports/.gitkeep

# Explorer component: commit the built dist/, never node_modules.
app/components/explorer/frontend/node_modules/
app/components/explorer/frontend/test-results/
app/components/explorer/frontend/playwright-report/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Web app (Next.js, web/)
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/*.tsbuildinfo
web/.env*.local
web/test-results/
web/playwright-report/
web/.vercel/
npm-debug.log*

# API / local demo state
data/demo_app.db*
reports/screenshots/

# Kaggle notebook local smoke-test outputs
kaggle/_work/
