{
  "name": "scholargrid-web",
  "version": "3.0.0",
  "private": true,
  "description": "ScholarGrid web app (Next.js) on top of the ScholarGrid FastAPI backend",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript openapi.json -o src/lib/api-types.ts",
    "gen:api:live": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/lib/api-types.ts"
  },
  "dependencies": {
    "@sigma/node-border": "3.0.0",
    "@tanstack/react-query": "5.108.3",
    "clsx": "2.1.1",
    "graphology": "0.25.4",
    "lucide-react": "0.577.0",
    "next": "15.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sigma": "3.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "graphology-types": "0.24.8",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
